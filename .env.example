# Copie para ".env" (cp .env.example .env) e preencha. NUNCA suba o .env para o git.

# Banco de dados (container "db")
MYSQL_DATABASE=aipo
MYSQL_USER=aipo
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Lidas pelo api.py (MYSQL_HOST e MYSQL_PORT são sobrescritas pelo docker-compose.yml)
MYSQL_HOST=db
MYSQL_PORT=3306

# Chave de assinatura dos tokens JWT. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
JWT_COOKIE_SECURE = False
JWT_ACCESS_COOKIE_PATH = '/'


#variáveis de ambiente para o frontend
REACT_APP_DATABASE_URL=